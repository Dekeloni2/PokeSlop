<Project Sdk="Microsoft.NET.Sdk">

    <!-- ══════════════════════════════════════════════════════════════════
         The game itself — all of it, and nothing about where it runs.

         This used to be the executable. It's now a library that two head
         projects sit on top of: TiltanTale.DesktopGL (a window, via SDL2)
         and TiltanTale.Blazor (a browser tab, via WebGL). Neither owns any
         game logic; they own an entry point and the answers to the handful
         of questions Game1 asks about its platform.

         That split is what the browser build needs. MonoGame has no web
         target, so the framework here is KNI (nkast.Xna.Framework) — a fork
         of MonoGame that keeps the same Microsoft.Xna.Framework API and adds
         one. Nothing in this project changed shape to accommodate it; the
         package references did.

         Note the framework packages are referenced here but no *platform*
         package is: this project compiles against the API and stays ignorant
         of the backend, which is exactly what lets both heads use it.
         ══════════════════════════════════════════════════════════════════ -->

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <!-- net8.0 because that's what KNI ships and what Blazor
             WebAssembly is happiest on; the heads target it too -->
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <TieredCompilation>false</TieredCompilation>
        <AssemblyName>TiltanTale.Game</AssemblyName>
        <RootNamespace>FinalProject</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001"/>
        <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001"/>
    </ItemGroup>

    <!-- Content/ lives here rather than in either head, because both build
         it. Each head points a KniContentReference at Content/Content.mgcb
         and gets it compiled for its own platform (.xnb next to the exe for
         desktop, .xnb under wwwroot for the browser) — see the heads'
         csproj files. The raw data files that don't go through the pipeline
         at all are listed in Content/RawContent.props, which both heads
         import for the same reason: one list, two consumers. -->
    <ItemGroup>
        <None Include="Content\Content.mgcb"/>
        <None Include="Content\RawContent.props"/>
    </ItemGroup>

</Project>
